# Oraculo v0 - exemplo sem segredos
#
# Copie este arquivo para .env.local na raiz do projeto, ou informe outro
# arquivo com ORACULO_ENV_FILE. Nunca versione segredos nem os coloque no frontend.
OPENAI_API_KEY=

# Roteamento de modelos OpenAI Responses API
ORACULO_MODEL_CRITICAL=gpt-5.6-sol
ORACULO_MODEL_STANDARD=gpt-5.6-terra
ORACULO_MODEL_LIGHT=gpt-5.6-luna

# Limites mensais em USD. No limite rigido, a v0 bloqueia chamadas automaticas.
MONTHLY_AI_BUDGET_USD=5
SOFT_WARNING_USD=4
HARD_LIMIT_USD=5

# Operacao local
# ORACULO_DATA_DIR aceita caminho absoluto ou relativo a raiz do projeto.
ORACULO_DATA_DIR=./data
# Opcional: sobrescreve a URL derivada de ORACULO_DATA_DIR.
# ORACULO_DATABASE_URL=sqlite:///./data/oraculo.db
# Opcional: caminho de outro arquivo de ambiente.
# ORACULO_ENV_FILE=./.env.local
ORACULO_API_URL=http://127.0.0.1:8000
ORACULO_APP_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=/api
ORACULO_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Agenda local (formato HH:MM, relogio de 24 horas)
ORACULO_TIMEZONE=UTC
ORACULO_SCHEDULER_ENABLED=true
ORACULO_MORNING_BRIEFING_TIME=08:00
ORACULO_EVENING_CHECKIN_TIME=19:00

# Pesquisa e regras deterministicas
ORACULO_WEB_SEARCH_ENABLED=true
ORACULO_EXTERNAL_INACTIVITY_DAYS=7
ORACULO_STALLED_PROJECT_DAYS=7

# Backups e diagnostico
ORACULO_BACKUP_RETENTION=7
ORACULO_LOG_LEVEL=INFO
